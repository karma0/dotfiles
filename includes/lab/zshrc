# lab: shortcuts for the home lab (k3s-lab on krad.site), sourced by host profiles that list `lab`.
# Works on the LAN and over Tailscale alike: the subnet routers advertise 172.29.0.0/20, and plain
# kubectl targets the lab (~/.kube/config -> ~/.kube/k3s-lab.yaml).

# This plugin's scripts (rig-attach, rig-seat).
export PATH="$DOTS/includes/lab/bin:$PATH"

# OpenRig tenants: open herdr inside the tenant pod with a rig's seats tiled. `rig-attach <tenant> [rig]`.
# One alias per running rig; with no rig named you land in herdr without a new view.
alias aktoh-dev='rig-attach aktoh aktoh-dev'      # Aktoh development team (lead, builder, reviewer)
alias aktoh-kernel='rig-attach aktoh kernel'       # the Aktoh tenant's OpenRig operator team
alias mindhive-dev='rig-attach mindhive mindhive-dev' # MindHive development team (lead, builder, reviewer)
alias mindhive-kernel='rig-attach mindhive kernel'   # the MindHive tenant's OpenRig operator team
alias tafylabs-dev='rig-attach tafylabs tafylabs-dev' # TafyLabs development team (lead, builder, reviewer)
alias tafylabs-kernel='rig-attach tafylabs kernel' # the TafyLabs tenant's OpenRig operator team

# Developer seats (one per repo) in a tenant's dev rig: list | add <repo> [--model M --effort E] | remove <repo>
# | sync [--prune] | reap [--idle 6h]. `rig-seat <tenant> ...`.
alias aktoh-seat='rig-seat aktoh'
alias mindhive-seat='rig-seat mindhive'
alias tafylabs-seat='rig-seat tafylabs'

# What a tenant is doing, read-only: seats + open rows; a row (qitem-…) with its notes; a seat's screen (seat@rig);
# `watch seat@rig` follows a seat live (read-only, Ctrl-b d). `rig-status <tenant> ...`.
alias aktoh-status='rig-status aktoh'
alias mindhive-status='rig-status mindhive'
alias tafylabs-status='rig-status tafylabs'
