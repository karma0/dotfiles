#!/usr/bin/env bash
# rig-seat — manage per-repo developer seats in an OpenRig tenant pod on k3s-lab, from the Mac.
#
#   rig-seat <tenant> list | add <repo> [--model M] [--effort E] | remove <repo> | sync [--prune] | reap [--idle 6h]
#   alias aktoh-seat='rig-seat aktoh'        (in ~/.homesick/includes/lab/zshrc)
#
# Runs tafy-rigs' bin/seat inside the tenant's rig container. The rig defaults to <tenant>-dev; set
# SEAT_RIG to target another rig in the tenant.
set -euo pipefail
tenant=${1:?usage: rig-seat <tenant> list|add|remove|sync|reap ...}
shift
rig=${SEAT_RIG:-$tenant-dev}
# A tenant without a dev rig (rig-tafylabs today: kernel only, no tafy-rigs on /work) has no `seat`.
# shellcheck disable=SC2016  # the inner script is expanded by the pod's bash, not here
exec kubectl -n "rig-$tenant" exec "rig-$tenant-0" -c rig -- bash -lc '
  command -v seat >/dev/null && [ -f "/work/tafy-rigs/rigs/$0/rig.yaml" ] || {
    echo "rig-seat: rig-'"$tenant"' has no dev rig $0 (no /work/tafy-rigs/rigs/$0); its kernel runs, but there are no seats to manage" >&2
    exit 1; }
  SEAT_RIG="$0" exec seat "$@"' "$rig" "$@"
